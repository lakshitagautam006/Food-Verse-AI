# ====================================================================
# Food Verse AI - Backend Environment Configuration (Groq Cloud AI)
# ====================================================================

# Cloud AI Provider: Groq Cloud API
# To generate a free Groq API key:
# 1. Visit Groq Console: https://console.groq.com/keys
# 2. Click "Create API Key"
# 3. Paste your key below:
GROQ_API_KEY=your_groq_api_key_here

# Supported Models on Groq
# Vision Model (Food Recognition, Freshness, Hygiene, Recipe Image):
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Text Model (Cooking Assistant & Meal Planning):
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
